# --- Admin login -----------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-long
SESSION_SECRET=generate-a-random-32-character-string

# --- Writable data in production (Vercel) ----------------------------------
# Vercel's filesystem is read-only at runtime, so admin edits are committed
# back to GitHub instead. Leave these blank for local development.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx   # fine-grained PAT, Contents: read/write
# GITHUB_REPO=your-username/adnkape
# GITHUB_BRANCH=main
# GITHUB_DATA_PATH=data/farms.json
